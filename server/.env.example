# Server port (local development only)
PORT=5000

# REQUIRED in production. Long random string (32+ characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret

# Password for the seeded demo admin account (phone 03000000001).
# Locally it defaults to "admin123"; in production a random password is
# generated on each cold start if this is not set.
ADMIN_PASSWORD=replace-with-a-strong-password

# Comma-separated list of browser origins allowed to call the API cross-origin.
# Leave empty for same-origin only (the deployed frontend uses relative /api).
# Example: https://bloodbridge-ai-two.vercel.app
ALLOWED_ORIGINS=

# MongoDB Atlas connection string.
# Set this in production (and optionally locally) for durable storage.
# Without it, the app falls back to server/data/bloodbridge-data.json.
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/bloodbridge
